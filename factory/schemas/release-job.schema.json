{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-asset-factory.local/schemas/release-job.schema.json",
  "title": "Blender Asset Factory Release Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "version", "authoritative_glb", "source_job_hash", "pixel_atlas", "uv_tolerance", "required_views", "views"],
  "properties": {
    "schema_version": {"const": 1},
    "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "authoritative_glb": {"type": "string", "minLength": 1},
    "source_job_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "pixel_atlas": {"type": "boolean"},
    "uv_tolerance": {"type": "number", "minimum": 0},
    "required_views": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "label": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
